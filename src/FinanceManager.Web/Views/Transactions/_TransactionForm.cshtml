@model TransactionFormViewModel
@{
    var accounts = ViewData["Accounts"] as List<Account> ?? [];
    var categories = ViewData["Categories"] as List<CategoryListItem> ?? [];
    var cards = ViewData["Cards"] as List<Card> ?? [];
}

<div class="fm-card form-narrow">
    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" novalidate>
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="AccountId">حساب *</label>
                <select class="form-select" asp-for="AccountId" data-accounts-select>
                    <option value="0">— انتخاب حساب —</option>
                    @foreach (var account in accounts)
                    {
                        var currency = CurrencyCatalog.Get(account.CurrencyCode);
                        <option value="@account.Id"
                                data-currency="@account.CurrencyCode"
                                data-currency-name="@currency.PersianName"
                                selected="@(Model.AccountId == account.Id)">
                            @account.Title — @account.BankName (@account.CurrencyCode)@(account.IsActive ? "" : " [غیرفعال]")
                        </option>
                    }
                </select>
                <span asp-validation-for="AccountId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Type">نوع تراکنش *</label>
                <select class="form-select" asp-for="Type" data-type-select>
                    <option value="1" selected="@(Model.Type == TransactionType.Deposit)">واریز</option>
                    <option value="2" selected="@(Model.Type == TransactionType.Withdrawal)">برداشت</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Amount">مبلغ *</label>
                <input class="form-control" asp-for="Amount" dir="ltr" inputmode="decimal" placeholder="0" />
                <div class="form-text" data-currency-hint></div>
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Date">تاریخ تراکنش *</label>
                <input class="form-control" asp-for="Date" placeholder="۱۴۰۳/۰۷/۲۲" inputmode="numeric" autocomplete="off" />
                <div class="form-text">تاریخ شمسی، مثل ۱۴۰۳/۰۷/۲۲</div>
                <span asp-validation-for="Date" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="CategoryId">دستهبندی</label>
                <select class="form-select" asp-for="CategoryId" data-categories-select>
                    <option value="">بدون دستهبندی</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id" data-kind="@((int)category.Kind)" selected="@(Model.CategoryId == category.Id)">
                            @category.Name@(category.IsActive ? "" : " [غیرفعال]")
                        </option>
                    }
                </select>
                <div class="form-text">لیست بر اساس نوع تراکنش فیلتر میشود.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="CardId">کارت (اختیاری)</label>
                <select class="form-select" asp-for="CardId" data-cards-select>
                    <option value="">بدون کارت</option>
                    @foreach (var card in cards)
                    {
                        <option value="@card.Id" data-account-id="@card.AccountId" selected="@(Model.CardId == card.Id)">
                            @card.Nickname — •••• @PersianText.ToPersianDigits(card.Last4)@(card.IsActive ? "" : " [غیرفعال]")
                        </option>
                    }
                </select>
                <div class="form-text">فقط کارتهای همان حساب قابل انتخاباند.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Description">شرح *</label>
                <input class="form-control" asp-for="Description" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="ReferenceNumber">شماره پیگیری</label>
                <input class="form-control" asp-for="ReferenceNumber" dir="ltr" />
                <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">ذخیره</button>
            <a class="btn btn-outline-secondary" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
