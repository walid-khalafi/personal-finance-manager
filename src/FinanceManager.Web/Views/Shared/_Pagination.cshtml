@model PaginationModel
@{
    string Url(int page) => QueryHelpers.AddQueryString(Model.BaseUrl, "page", page.ToString());
    var start = Math.Max(1, Model.Page - 3);
    var end = Math.Min(Model.TotalPages, start + 6);
    start = Math.Max(1, end - 6);
}
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="صفحهبندی">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url(Model.Page - 1)">قبلی</a>
            </li>
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url(i)">@PersianText.ToPersianDigits(i.ToString())</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url(Model.Page + 1)">بعدی</a>
            </li>
        </ul>
    </nav>
}
