@model CategoryReportViewModel
@{
    ViewData["Title"] = "گزارش دستهبندیها";
    var currencyCode = Model.Report.CurrencyCode;
    var decimals = currencyCode.Length > 0 ? CurrencyCatalog.Get(currencyCode).Decimals : 0;
    var currencyName = currencyCode.Length > 0 ? CurrencyCatalog.Get(currencyCode).PersianName : "";
    var hasRows = Model.Report.Rows.Count > 0;
}

<partial name="_PeriodSelector" model="@(new PeriodSelectorModel
    {
        Selection = Model.Selection,
        CurrencyCode = currencyCode.Length > 0 ? currencyCode : null,
        Currencies = Model.Currencies,
    })" />

@if (Model.Selection.Error is not null)
{
    <div class="alert alert-warning small">@Model.Selection.Error</div>
}

<div class="btn-group mb-3" role="group" aria-label="نوع تراکنش">
    <a class="btn @(Model.Type == TransactionType.Withdrawal ? "btn-primary" : "btn-outline-primary")"
       asp-action="Categories" asp-route-period="@((int)Model.Selection.Kind)"
       asp-route-from="@Model.Selection.FromText" asp-route-to="@Model.Selection.ToText"
       asp-route-currency="@currencyCode" asp-route-type="2">برداشتها</a>
    <a class="btn @(Model.Type == TransactionType.Deposit ? "btn-primary" : "btn-outline-primary")"
       asp-action="Categories" asp-route-period="@((int)Model.Selection.Kind)"
       asp-route-from="@Model.Selection.FromText" asp-route-to="@Model.Selection.ToText"
       asp-route-currency="@currencyCode" asp-route-type="1">واریزها</a>
</div>

@if (!hasRows)
{
    <div class="fm-card">
        <div class="empty-state">
            <i class="bi bi-pie-chart"></i>
            تراکنشی برای این تراز در دوره انتخابی وجود ندارد.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="fm-card h-100">
                <h3 class="h6 fw-bold mb-3">توزیع سهم دستهبندیها (@currencyName)</h3>
                <div class="chart-box"><canvas id="categoryReportChart" aria-label="نمودار دستهبندیها"></canvas></div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="fm-card h-100">
                <h3 class="h6 fw-bold mb-3">
                    جزئیات — جمع کل: @Display.Money(Model.Report.TotalMinor, currencyCode)
                    <small class="text-muted">(@PersianText.ToPersianDigits(Model.Report.TotalCount.ToString()) تراکنش)</small>
                </h3>
                <div class="table-responsive">
                    <table class="table table-fm">
                        <thead>
                            <tr>
                                <th>دستهبندی</th>
                                <th>مبلغ کل</th>
                                <th>تعداد</th>
                                <th>سهم</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Report.Rows)
                            {
                                <tr>
                                    <td>@row.Name</td>
                                    <td class="text-nowrap">@Display.Money(row.TotalMinor, currencyCode)</td>
                                    <td>@PersianText.ToPersianDigits(row.Count.ToString())</td>
                                    <td>@Display.Percent(row.Share)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (hasRows)
    {
        <script>
            (function () {
                const rows = @Json.Serialize(Model.Report.Rows.Select(r => new { name = r.Name, total = r.TotalMinor }));
                const decimals = @decimals;
                const currencyName = @Json.Serialize(currencyName);
                const el = document.getElementById('categoryReportChart');
                if (!el) { return; }
                new Chart(el, {
                    type: 'doughnut',
                    data: {
                        labels: rows.map(r => r.name),
                        datasets: [{
                            data: rows.map(r => r.total),
                            backgroundColor: rows.map((r, i) => FM.palette[i % FM.palette.length]),
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '58%',
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ctx.label + ': ' + FM.formatMoney(ctx.parsed, decimals, currencyName);
                                    }
                                }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}
