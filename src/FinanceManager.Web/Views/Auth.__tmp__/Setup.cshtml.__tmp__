@model SetupViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "راهاندازی اولیه";
}
<h1 class="h4 fw-bold mb-1">راهاندازی اولیه</h1>
<p class="text-muted small mb-4">
    این نخستین اجرای برنامه است. یک نام کاربری و گذرواژه برای خود بسازید؛
    همه دادههای مالی با همین حساب محافظت میشوند.
</p>

<form asp-controller="Auth" asp-action="Setup" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="mb-3">
        <label class="form-label" for="Username">نام کاربری</label>
        <input class="form-control" asp-for="Username" autocomplete="username" autofocus dir="ltr" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Password">گذرواژه</label>
        <input class="form-control" asp-for="Password" autocomplete="new-password" dir="ltr" />
        <div class="form-text">حداقل ۸ نویسه.</div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="ConfirmPassword">تکرار گذرواژه</label>
        <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" dir="ltr" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button class="btn btn-primary w-100" type="submit">ساخت حساب و شروع</button>
</form>
