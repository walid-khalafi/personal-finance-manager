@model TransactionTableModel
@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        تراکنشی برای نمایش وجود ندارد.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-fm align-middle">
            <thead>
                <tr>
                    <th>تاریخ</th>
                    @if (Model.ShowAccountColumn)
                    {
                        <th>حساب</th>
                    }
                    <th>نوع</th>
                    <th>مبلغ</th>
                    <th>دستهبندی</th>
                    <th>شرح</th>
                    <th>پیگیری</th>
                    @if (Model.ShowActions)
                    {
                        <th class="text-end">عملیات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap">@Display.Date(item.TransactionDate)</td>
                        @if (Model.ShowAccountColumn)
                        {
                            <td>
                                <a asp-controller="Transactions" asp-action="Index" asp-route-accountId="@item.AccountId"
                                   title="@item.BankName">@item.AccountTitle</a>
                            </td>
                        }
                        <td>
                            @if (item.IsTransfer)
                            {
                                <span class="badge badge-soft-primary" title="انتقال داخلی">
                                    <i class="bi bi-arrow-left-right me-1"></i>انتقال
                                </span>
                            }
                            else if (item.Type == TransactionType.Deposit)
                            {
                                <span class="badge badge-soft-success">واریز</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger">برداشت</span>
                            }
                        </td>
                        <td class="text-nowrap @Display.AmountClass(item.Type)">
                            @Display.SignedAmount(item.AmountMinor, item.CurrencyCode, item.Type) <small>@item.CurrencyCode</small>
                        </td>
                        <td>@(item.CategoryName ?? "—")</td>
                        <td class="text-truncate" style="max-width: 260px;" title="@item.Description">@item.Description</td>
                        <td class="text-nowrap">@(item.ReferenceNumber ?? "—")</td>
                        @if (Model.ShowActions)
                        {
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Transactions" asp-action="Details" asp-route-id="@item.Id" title="جزئیات">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (!item.IsTransfer)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Transactions" asp-action="Edit" asp-route-id="@item.Id" title="ویرایش">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-controller="Transactions" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('این تراکنش حذف شود؟');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else if (item.TransferGroupId is not null)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Transfers" asp-action="Edit" asp-route-id="@item.TransferGroupId" title="ویرایش انتقال">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
