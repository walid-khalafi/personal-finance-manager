@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ورود";
}
<h1 class="h4 fw-bold mb-1">ورود به حساب</h1>
<p class="text-muted small mb-4">برای مشاهده دادههای مالی، وارد شوید.</p>

<form asp-controller="Auth" asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="mb-3">
        <label class="form-label" for="Username">نام کاربری</label>
        <input class="form-control" asp-for="Username" autocomplete="username" autofocus dir="ltr" />
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="Password">گذرواژه</label>
        <input class="form-control" asp-for="Password" autocomplete="current-password" dir="ltr" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="RememberMe" />
        <label class="form-check-label" for="RememberMe">مرا به خاطر بسپار</label>
    </div>

    <button class="btn btn-primary w-100" type="submit">ورود</button>
</form>
