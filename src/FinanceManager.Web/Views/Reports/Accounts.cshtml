@model AccountReportViewModel
@{
    ViewData["Title"] = "گزارش حسابها";
    var currencyCode = Model.CurrencyCode ?? "";
    var decimals = currencyCode.Length > 0 ? CurrencyCatalog.Get(currencyCode).Decimals : 0;
    var currencyName = currencyCode.Length > 0 ? CurrencyCatalog.Get(currencyCode).PersianName : "";
    var hasRows = Model.Rows.Count > 0;
}

<partial name="_PeriodSelector" model="@(new PeriodSelectorModel
    {
        Selection = Model.Selection,
        CurrencyCode = currencyCode.Length > 0 ? currencyCode : null,
        Currencies = Model.Currencies,
    })" />

@if (Model.Selection.Error is not null)
{
    <div class="alert alert-warning small">@Model.Selection.Error</div>
}

@if (!hasRows)
{
    <div class="fm-card">
        <div class="empty-state">
            <i class="bi bi-bank"></i>
            حسابی برای این ارز ثبت نشده است.
        </div>
    </div>
}
else
{
    <div class="fm-card mb-3">
        <h3 class="h6 fw-bold mb-3">گردش حسابها در دوره (@currencyName)</h3>
        <div class="table-responsive">
            <table class="table table-fm">
                <thead>
                    <tr>
                        <th>حساب</th>
                        <th>بانک</th>
                        <th>موجودی آغاز دوره</th>
                        <th>واریزها</th>
                        <th>برداشتها</th>
                        <th>انتقال ورودی</th>
                        <th>انتقال خروجی</th>
                        <th>خالص دوره</th>
                        <th>موجودی پایان دوره</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Transactions" asp-action="Index" asp-route-accountId="@row.AccountId">@row.Title</a>
                            </td>
                            <td>@row.BankName</td>
                            <td class="text-nowrap">@Display.Money(row.OpeningMinor, currencyCode)</td>
                            <td class="text-nowrap amount-deposit">@Display.Money(row.DepositsMinor, currencyCode)</td>
                            <td class="text-nowrap amount-withdrawal">@Display.Money(row.WithdrawalsMinor, currencyCode)</td>
                            <td class="text-nowrap">@Display.Money(row.TransfersInMinor, currencyCode)</td>
                            <td class="text-nowrap">@Display.Money(row.TransfersOutMinor, currencyCode)</td>
                            <td class="text-nowrap fw-bold @(row.NetMinor >= 0 ? "amount-deposit" : "amount-withdrawal")">@Display.Money(row.NetMinor, currencyCode)</td>
                            <td class="text-nowrap fw-bold">@Display.Money(row.ClosingMinor, currencyCode)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">
            موجودی آغاز دوره شامل موجودی اولیه و همه اقلام پیش از شروع دوره است.
            خالص دوره = واریزها − برداشتها + انتقال ورودی − انتقال خروجی؛ و موجودی پایان = موجودی آغاز + خالص دوره.
        </div>
    </div>

    <div class="fm-card">
        <h3 class="h6 fw-bold mb-3">موجودی پایان حسابها (@currencyName)</h3>
        <div class="chart-box"><canvas id="accountsChart" aria-label="نمودار موجودی حسابها"></canvas></div>
    </div>
}

@section Scripts {
    @if (hasRows)
    {
        <script>
            (function () {
                const rows = @Json.Serialize(Model.Rows.Select(r => new { title = r.Title, closing = r.ClosingMinor }));
                const decimals = @decimals;
                const currencyName = @Json.Serialize(currencyName);
                const el = document.getElementById('accountsChart');
                if (!el) { return; }
                new Chart(el, {
                    type: 'bar',
                    data: {
                        labels: rows.map(r => r.title),
                        datasets: [{
                            label: 'موجودی پایان دوره',
                            data: rows.map(r => r.closing),
                            backgroundColor: rows.map((r, i) => FM.palette[i % FM.palette.length]),
                            borderRadius: 6,
                            maxBarThickness: 60
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { callback: function (v) { return FM.formatMoney(v, decimals, ''); } } },
                            x: { grid: { display: false } }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return FM.formatMoney(ctx.parsed.y, decimals, currencyName);
                                    }
                                }
                            }
                        }
                    }
                });
            })();
        </script>
    }
}
