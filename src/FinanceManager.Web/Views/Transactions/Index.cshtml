@model TransactionListViewModel
@{
    ViewData["Title"] = "تراکنشها";
    var filter = Model.Filter;
    var sortOptions = new (TransactionSort Value, string Label)[]
    {
        (TransactionSort.DateDesc, "تاریخ (جدیدترین)"),
        (TransactionSort.DateAsc, "تاریخ (قدیمیترین)"),
        (TransactionSort.AmountDesc, "مبلغ (بیشترین)"),
        (TransactionSort.AmountAsc, "مبلغ (کمترین)"),
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted small">@PersianText.ToPersianDigits(Model.Page.TotalCount.ToString()) تراکنش یافت شد</span>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-controller="Transfers" asp-action="Create">
            <i class="bi bi-arrow-left-right me-1"></i>انتقال بین حسابها
        </a>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>تراکنش جدید
        </a>
    </div>
</div>

<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="accountId">حساب</label>
        <select class="form-select" id="accountId" name="accountId">
            <option value="">همه حسابها</option>
            @foreach (var account in Model.Accounts)
            {
                <option value="@account.Id" selected="@(filter.AccountId == account.Id)">
                    @account.Title (@account.CurrencyCode)@(account.IsActive ? "" : " [غیرفعال]")
                </option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="type">نوع</label>
        <select class="form-select" id="type" name="type">
            <option value="">همه</option>
            <option value="1" selected="@(filter.Type == TransactionType.Deposit)">واریز</option>
            <option value="2" selected="@(filter.Type == TransactionType.Withdrawal)">برداشت</option>
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="categoryId">دستهبندی</label>
        <select class="form-select" id="categoryId" name="categoryId">
            <option value="">همه</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(filter.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="from">از تاریخ</label>
        <input class="form-control" id="from" name="from" value="@Model.FromText" placeholder="۱۴۰۳/۰۷/۰۱" inputmode="numeric" autocomplete="off" />
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="to">تا تاریخ</label>
        <input class="form-control" id="to" name="to" value="@Model.ToText" placeholder="۱۴۰۳/۰۷/۳۰" inputmode="numeric" autocomplete="off" />
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="q">جستوجو</label>
        <input class="form-control" id="q" name="q" value="@filter.Search" placeholder="شرح یا شماره پیگیری" />
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label" for="sort">ترتیب</label>
        <select class="form-select" id="sort" name="sort">
            @foreach (var option in sortOptions)
            {
                <option value="@((int)option.Value)" selected="@(filter.Sort == option.Value)">@option.Label</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>اعمال</button>
        <a class="btn btn-outline-secondary" asp-action="Index">پاککردن</a>
    </div>
</form>

@if (Model.FilterError is not null)
{
    <div class="alert alert-warning small">@Model.FilterError</div>
}

<div class="fm-card">
    <partial name="_TransactionTable" model="@(new TransactionTableModel { Items = Model.Page.Items.ToList() })" />
</div>

@if (Model.PageBaseUrl is not null)
{
    <partial name="_Pagination" model="@(new PaginationModel
        {
            Page = Model.Page.Page,
            TotalPages = Model.Page.TotalPages,
            BaseUrl = Model.PageBaseUrl,
        })" />
}
