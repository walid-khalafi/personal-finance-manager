@model SettingsViewModel
@{
    ViewData["Title"] = "تنظیمات";
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="fm-card h-100">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-currency-exchange me-1"></i>ارز پیشفرض</h3>
            <p class="text-muted small">
                ارز پیشفرض برای فرمهای جدید و گزارشهای پیشفرض استفاده میشود.
                هر حساب ارز خودش را دارد و مجموعهای ریالی و دلاری هرگز با هم جمع نمیشوند.
            </p>
            <form asp-action="SetDefaultCurrency" method="post" class="row g-2 align-items-end">
                <div class="col-8">
                    <label class="form-label" for="currencyCode">ارز پیشفرض</label>
                    <select class="form-select" id="currencyCode" name="currencyCode">
                        @foreach (var currency in Model.Currencies)
                        {
                            <option value="@currency.Code" selected="@(string.Equals(Model.DefaultCurrency, currency.Code, StringComparison.OrdinalIgnoreCase))">
                                @currency.PersianName (@currency.Code)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-4">
                    <button class="btn btn-primary w-100" type="submit">ذخیره</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="fm-card h-100">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-shield-lock me-1"></i>تغییر گذرواژه</h3>
            <form asp-action="ChangePassword" method="post" class="row g-2">
                <div class="col-12">
                    <label class="form-label" for="CurrentPassword">گذرواژه فعلی</label>
                    <input class="form-control" type="password" id="CurrentPassword" name="CurrentPassword" required autocomplete="current-password" dir="ltr" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="NewPassword">گذرواژه جدید</label>
                    <input class="form-control" type="password" id="NewPassword" name="NewPassword" required minlength="8" autocomplete="new-password" dir="ltr" />
                    <div class="form-text">حداقل ۸ نویسه.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ConfirmPassword">تکرار گذرواژه جدید</label>
                    <input class="form-control" type="password" id="ConfirmPassword" name="ConfirmPassword" required autocomplete="new-password" dir="ltr" />
                </div>
                <div class="col-12 mt-2">
                    <button class="btn btn-primary" type="submit">تغییر گذرواژه</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12">
        <div class="fm-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <h3 class="h6 fw-bold mb-0"><i class="bi bi-database-down me-1"></i>پشتیبانگیری</h3>
                <form asp-action="CreateBackup" method="post" class="m-0">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-plus-lg me-1"></i>ایجاد نسخه پشتیبان
                    </button>
                </form>
            </div>
            <p class="text-muted small mb-2">
                نسخه پشتیبان با روش رسمی و سازگار SQLite (Online Backup) ساخته میشود و فایل امن برای بازیابی است.
                برای بازیابی: برنامه را ببندید؛ فایل <code>finance.db</code> را با فایل پشتیبان جایگزین کنید
                (و در صورت وجود، فایلهای <code>finance.db-wal</code> و <code>finance.db-shm</code> را حذف کنید)؛ سپس برنامه را دوباره اجرا کنید.
            </p>

            @if (Model.Backups.Count == 0)
            {
                <div class="empty-state py-3">
                    <i class="bi bi-archive"></i>
                    هنوز نسخه پشتیبانی ساخته نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-fm">
                        <thead>
                            <tr>
                                <th>فایل</th>
                                <th>حجم</th>
                                <th>تاریخ ساخت</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var backup in Model.Backups)
                            {
                                <tr>
                                    <td dir="ltr" class="text-end">@backup.Name</td>
                                    <td>@Display.FileSize(backup.SizeBytes)</td>
                                    <td>@PersianText.FormatTimestamp(backup.CreatedUtc)</td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="DownloadBackup" asp-route-name="@backup.Name" title="دانلود">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <form asp-action="DeleteBackup" asp-route-name="@backup.Name" method="post" class="d-inline"
                                              onsubmit="return confirm('این فایل پشتیبان حذف شود؟');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="fm-card">
            <h3 class="h6 fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>اطلاعات سیستم</h3>
            <dl class="row detail-list mb-0">
                <dt class="col-md-3">پوشه داده</dt>
                <dd class="col-md-9"><code dir="ltr">@Model.DataDirectory</code></dd>
                <dt class="col-md-3">پایگاه داده</dt>
                <dd class="col-md-9"><code dir="ltr">@Model.DatabasePath</code></dd>
            </dl>
            <div class="text-muted small mt-2">
                همه دادهها روی همین دستگاه ذخیره میشوند و برنامه پس از نصب، بدون اینترنت کار میکند.
                پایگاه داده رمزنگاریشده نیست؛ امنیت آن به امنیت همین ویندوز و حساب کاربری شما وابسته است.
            </div>
        </div>
    </div>
</div>
