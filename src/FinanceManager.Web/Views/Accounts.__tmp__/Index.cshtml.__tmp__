@model AccountIndexViewModel
@{
    ViewData["Title"] = "حسابها";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.TotalsByCurrency.Count > 0)
        {
            @foreach (var total in Model.TotalsByCurrency)
            {
                <span class="badge badge-soft-primary fs-6 fw-normal py-2">
                    موجودی فعال (@CurrencyCatalog.Get(total.CurrencyCode).PersianName):
                    <strong>@Display.Money(total.TotalMinor, total.CurrencyCode)</strong>
                </span>
            }
        }
        else
        {
            <span class="text-muted small">هنوز حساب فعالی ندارید.</span>
        }
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i>حساب جدید
    </a>
</div>

@if (Model.Accounts.Count == 0)
{
    <div class="fm-card">
        <div class="empty-state">
            <i class="bi bi-bank2"></i>
            <p class="mb-2">هنوز حسابی ثبت نشده است.</p>
            <a class="btn btn-primary" asp-action="Create">ثبت نخستین حساب</a>
        </div>
    </div>
}
else
{
    <div class="fm-card">
        <div class="table-responsive">
            <table class="table table-fm">
                <thead>
                    <tr>
                        <th>حساب</th>
                        <th>بانک</th>
                        <th>نوع</th>
                        <th>ارز</th>
                        <th>شماره حساب</th>
                        <th>شبا</th>
                        <th>موجودی</th>
                        <th>وضعیت</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr class="@(account.IsActive ? "" : "opacity-75")">
                            <td class="fw-semibold">
                                <a asp-controller="Transactions" asp-action="Index" asp-route-accountId="@account.Id"
                                   title="مشاهده تراکنشهای این حساب">@account.Title</a>
                            </td>
                            <td>@account.BankName</td>
                            <td>@Display.AccountTypeLabel(account.Type)</td>
                            <td><span class="badge badge-soft-muted">@account.CurrencyCode</span></td>
                            <td>@Display.Mask(account.AccountNumber)</td>
                            <td>@Display.Mask(account.Iban)</td>
                            <td class="text-nowrap">@Display.Money(account.BalanceMinor, account.CurrencyCode)</td>
                            <td>
                                @if (account.IsActive)
                                {
                                    <span class="badge badge-soft-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-muted">غیرفعال</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@account.Id" title="ویرایش">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@account.Id" method="post" class="d-inline">
                                    <input type="hidden" name="active" value="@((!account.IsActive).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="@(account.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                        <i class="bi @(account.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@account.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('این حساب حذف شود؟ حذف فقط برای حسابهای بدون تراکنش و کارت ممکن است.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
