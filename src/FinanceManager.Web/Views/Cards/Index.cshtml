@model CardIndexViewModel
@{
    ViewData["Title"] = "کارتها";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted small">کارت به حساب وابسته است؛ تراکنشهای کارت روی موجودی همان حساب اثر میگذارند.</span>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i>کارت جدید
    </a>
</div>

@if (Model.Cards.Count == 0)
{
    <div class="fm-card">
        <div class="empty-state">
            <i class="bi bi-credit-card"></i>
            <p class="mb-2">هنوز کارتی ثبت نشده است.</p>
            <a class="btn btn-primary" asp-action="Create">ثبت نخستین کارت</a>
        </div>
    </div>
}
else
{
    <div class="fm-card">
        <div class="table-responsive">
            <table class="table table-fm">
                <thead>
                    <tr>
                        <th>کارت</th>
                        <th>حساب</th>
                        <th>بانک</th>
                        <th>شماره کارت</th>
                        <th>انقضا</th>
                        <th>تراکنشها</th>
                        <th>وضعیت</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.Cards)
                    {
                        <tr class="@(card.IsActive ? "" : "opacity-75")">
                            <td class="fw-semibold">@card.Nickname</td>
                            <td>@card.AccountTitle</td>
                            <td>@card.BankName</td>
                            <td>@Display.MaskCard(card.Last4)</td>
                            <td class="text-nowrap">
                                @if (card.ExpiryMonth is not null && card.ExpiryYear is not null)
                                {
                                    @PersianText.ToPersianDigits($"{card.ExpiryMonth:00}/{card.ExpiryYear}")
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@PersianText.ToPersianDigits(card.TransactionCount.ToString())</td>
                            <td>
                                @if (card.IsActive)
                                {
                                    <span class="badge badge-soft-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-muted">غیرفعال</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@card.Id" title="ویرایش">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@card.Id" method="post" class="d-inline">
                                    <input type="hidden" name="active" value="@((!card.IsActive).ToString().ToLowerInvariant())" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="@(card.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                        <i class="bi @(card.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@card.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('این کارت حذف شود؟ تراکنشهای مرتبط، ارجاع کارتشان حذف میشود.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
