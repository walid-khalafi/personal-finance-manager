@model TransferListViewModel
@{
    ViewData["Title"] = "انتقالها";
    var filter = Model.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted small">
        انتقالها فقط بین حسابهایی با ارز یکسان ممکناند و در جمع درآمد/هزینه لحاظ نمیشوند.
    </span>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i>انتقال جدید
    </a>
</div>

<form method="get" class="filter-bar row g-2 align-items-end">
    <div class="col-6 col-md-3">
        <label class="form-label" for="accountId">حساب</label>
        <select class="form-select" id="accountId" name="accountId">
            <option value="">همه حسابها</option>
            @foreach (var account in Model.Accounts)
            {
                <option value="@account.Id" selected="@(filter.AccountId == account.Id)">
                    @account.Title (@account.CurrencyCode)@(account.IsActive ? "" : " [غیرفعال]")
                </option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="from">از تاریخ</label>
        <input class="form-control" id="from" name="from" value="@Model.FromText" placeholder="۱۴۰۳/۰۷/۰۱" inputmode="numeric" autocomplete="off" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label" for="to">تا تاریخ</label>
        <input class="form-control" id="to" name="to" value="@Model.ToText" placeholder="۱۴۰۳/۰۷/۳۰" inputmode="numeric" autocomplete="off" />
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>اعمال</button>
        <a class="btn btn-outline-secondary" asp-action="Index">پاککردن</a>
    </div>
</form>

@if (Model.FilterError is not null)
{
    <div class="alert alert-warning small">@Model.FilterError</div>
}

@if (Model.Page.TotalCount == 0)
{
    <div class="fm-card">
        <div class="empty-state">
            <i class="bi bi-arrow-left-right"></i>
            انتقالی یافت نشد.
        </div>
    </div>
}
else
{
    <div class="fm-card">
        <div class="table-responsive">
            <table class="table table-fm">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>از حساب</th>
                        <th>به حساب</th>
                        <th>مبلغ</th>
                        <th>شرح</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Page.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@Display.Date(item.TransactionDate)</td>
                            <td>
                                <div class="fw-semibold">@item.FromAccountTitle</div>
                                <div class="text-muted small">@item.FromBankName</div>
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    <i class="bi bi-arrow-left me-1 text-muted"></i>@item.ToAccountTitle
                                </div>
                                <div class="text-muted small">@item.ToBankName</div>
                            </td>
                            <td class="text-nowrap">@Display.Money(item.AmountMinor, item.CurrencyCode) <small class="text-muted">@item.CurrencyCode</small></td>
                            <td class="text-truncate" style="max-width: 240px;" title="@item.Description">@item.Description</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.GroupId" title="ویرایش">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.GroupId" method="post" class="d-inline"
                                      onsubmit="return confirm('این انتقال حذف شود؟ هر دو قلم دفتر کل حذف میشوند.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.PageBaseUrl is not null)
    {
        <partial name="_Pagination" model="@(new PaginationModel
            {
                Page = Model.Page.Page,
                TotalPages = Model.Page.TotalPages,
                BaseUrl = Model.PageBaseUrl,
            })" />
    }
}
