@{
    ViewData["Title"] = "گزارشها";
}

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="fm-card stat-card h-100">
            <div class="stat-icon bg-blue"><i class="bi bi-calculator"></i></div>
            <div>
                <h3 class="h6 fw-bold mb-1">خلاصه مالی</h3>
                <p class="text-muted small mb-2">موجودی آغاز و پایان دوره، جمع واریز و برداشت و خالص جریان نقدی — به تفکیک ارز.</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Summary">مشاهده گزارش</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="fm-card stat-card h-100">
            <div class="stat-icon bg-violet"><i class="bi bi-bar-chart"></i></div>
            <div>
                <h3 class="h6 fw-bold mb-1">گزارش ماهانه</h3>
                <p class="text-muted small mb-2">واریز و برداشت و خالص جریان نقدی در هر ماه شمسی دوره انتخابی.</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Monthly">مشاهده گزارش</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="fm-card stat-card h-100">
            <div class="stat-icon bg-green"><i class="bi bi-bank"></i></div>
            <div>
                <h3 class="h6 fw-bold mb-1">گزارش حسابها</h3>
                <p class="text-muted small mb-2">گردش هر حساب در دوره: واریز، برداشت، انتقال ورودی/خروجی و موجودی پایان.</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Accounts">مشاهده گزارش</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="fm-card stat-card h-100">
            <div class="stat-icon bg-amber"><i class="bi bi-pie-chart"></i></div>
            <div>
                <h3 class="h6 fw-bold mb-1">گزارش دستهبندیها</h3>
                <p class="text-muted small mb-2">توزیع برداشتها (یا واریزها) بر اساس دستهبندی در دوره انتخابی.</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Categories">مشاهده گزارش</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="fm-card stat-card h-100">
            <div class="stat-icon bg-red"><i class="bi bi-list-ul"></i></div>
            <div>
                <h3 class="h6 fw-bold mb-1">گزارش تراکنشها</h3>
                <p class="text-muted small mb-2">فهرست کامل تراکنشها با فیلتر تاریخ، حساب، نوع و دستهبندی.</p>
                <a class="btn btn-sm btn-outline-primary" asp-action="Transactions">مشاهده گزارش</a>
            </div>
        </div>
    </div>
</div>
