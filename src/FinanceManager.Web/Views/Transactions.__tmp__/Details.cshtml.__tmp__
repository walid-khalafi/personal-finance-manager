@model TransactionListItem
@{
    ViewData["Title"] = "جزئیات تراکنش";
}

<div class="fm-card form-narrow">
    <dl class="row detail-list mb-4">
        <dt class="col-4 col-md-3">تاریخ</dt>
        <dd class="col-8 col-md-9">@Display.Date(Model.TransactionDate)</dd>

        <dt class="col-4 col-md-3">حساب</dt>
        <dd class="col-8 col-md-9">
            <a asp-controller="Transactions" asp-action="Index" asp-route-accountId="@Model.AccountId">@Model.AccountTitle</a>
            <span class="text-muted small">— @Model.BankName</span>
        </dd>

        <dt class="col-4 col-md-3">نوع</dt>
        <dd class="col-8 col-md-9">
            @if (Model.IsTransfer)
            {
                <span class="badge badge-soft-primary"><i class="bi bi-arrow-left-right me-1"></i>انتقال داخلی</span>
            }
            else if (Model.Type == TransactionType.Deposit)
            {
                <span class="badge badge-soft-success">واریز</span>
            }
            else
            {
                <span class="badge badge-soft-danger">برداشت</span>
            }
        </dd>

        <dt class="col-4 col-md-3">مبلغ</dt>
        <dd class="col-8 col-md-9 fw-bold @Display.AmountClass(Model.Type)">
            @Display.SignedAmount(Model.AmountMinor, Model.CurrencyCode, Model.Type)
            <small class="text-muted">@CurrencyCatalog.Get(Model.CurrencyCode).PersianName</small>
        </dd>

        <dt class="col-4 col-md-3">دستهبندی</dt>
        <dd class="col-8 col-md-9">@(Model.CategoryName ?? "—")</dd>

        <dt class="col-4 col-md-3">کارت</dt>
        <dd class="col-8 col-md-9">@(Model.CardNickname ?? "—")</dd>

        <dt class="col-4 col-md-3">شرح</dt>
        <dd class="col-8 col-md-9">@Model.Description</dd>

        <dt class="col-4 col-md-3">شماره پیگیری</dt>
        <dd class="col-8 col-md-9">@(Model.ReferenceNumber ?? "—")</dd>

        <dt class="col-4 col-md-3">زمان ثبت</dt>
        <dd class="col-8 col-md-9 text-muted">@Display.Timestamp(Model.CreatedAtUtc)</dd>
    </dl>

    @if (Model.IsTransfer && Model.TransferGroupId is not null)
    {
        <div class="alert alert-info small">
            این تراکنش بخشی از یک انتقال داخلی بین حسابهاست و در جمعهای درآمد/هزینه لحاظ نمیشود.
            <a asp-controller="Transfers" asp-action="Edit" asp-route-id="@Model.TransferGroupId" class="alert-link">مشاهده انتقال</a>
        </div>
    }

    <div class="d-flex gap-2 flex-wrap">
        @if (!Model.IsTransfer)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">ویرایش</a>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('این تراکنش حذف شود؟');">
            <button type="submit" class="btn btn-outline-danger">حذف</button>
        </form>
        <a class="btn btn-outline-secondary" asp-action="Index">بازگشت به فهرست</a>
    </div>
</div>
