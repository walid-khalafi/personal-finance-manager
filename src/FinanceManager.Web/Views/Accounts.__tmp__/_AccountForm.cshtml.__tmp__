@model AccountFormViewModel

<div class="fm-card form-narrow">
    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" novalidate>
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="BankName">نام بانک *</label>
                <input class="form-control" asp-for="BankName" />
                <span asp-validation-for="BankName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Title">عنوان حساب *</label>
                <input class="form-control" asp-for="Title" />
                <div class="form-text">نام مستعار مثل «حساب حقوق» یا «خرج روزانه»</div>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Type">نوع حساب</label>
                <select class="form-select" asp-for="Type">
                    @foreach (var type in Enum.GetValues<AccountType>())
                    {
                        <option value="@((int)type)" selected="@(Model.Type == type)">@Display.AccountTypeLabel(type)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="CurrencyCode">ارز *</label>
                <select class="form-select" asp-for="CurrencyCode">
                    @foreach (var currency in CurrencyCatalog.All)
                    {
                        <option value="@currency.Code" selected="@(string.Equals(Model.CurrencyCode, currency.Code, StringComparison.OrdinalIgnoreCase))">
                            @currency.PersianName (@currency.Code)
                        </option>
                    }
                </select>
                <div class="form-text">پس از ثبت تراکنش، تغییر ارز ممکن نیست.</div>
                <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="OpeningBalance">موجودی اولیه *</label>
                <input class="form-control" asp-for="OpeningBalance" dir="ltr" inputmode="decimal" />
                <div class="form-text">موجودی پیش از ثبت هر تراکنش؛ در گزارش دوره بهعنوان واریز شمرده نمیشود.</div>
                <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="AccountNumber">شماره حساب</label>
                <input class="form-control" asp-for="AccountNumber" dir="ltr" />
                <div class="form-text">اختیاری؛ در فهرستها پوشانده میشود.</div>
                <span asp-validation-for="AccountNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="Iban">شماره شبا</label>
                <input class="form-control" asp-for="Iban" dir="ltr" placeholder="IR..." />
                <span asp-validation-for="Iban" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" for="IsActive">حساب فعال است</label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label" for="Notes">یادداشت</label>
                <textarea class="form-control" asp-for="Notes" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">ذخیره</button>
            <a class="btn btn-outline-secondary" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
